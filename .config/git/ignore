# Dotfiles .gitignore - Prevents committing sensitive/temporary files

# ============================================================================
# SECRETS & CREDENTIALS (CRITICAL!)
# ============================================================================
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
*secret*
*password*
*token*
*credentials*
.ssh/id_*
.ssh/*_rsa*
.ssh/known_hosts
.ssh/authorized_keys
.gnupg/*.key
.gnupg/private-keys-v1.d/
.aws/credentials
.kube/config
.docker/config.json
.config/gh/hosts.yml

# --- gaps found 2026-09-01: untracked AND unignored on a public repo ---
# The .gnupg/.ssh rules above are anchored at $HOME and miss the XDG copies.
.config/gnupg/
.pki/
.config/libaccounts-glib/
.config/kdeconnect/
# `.env` / `.env.*` above match only a file named exactly .env; this catches
# pokeagent.env and friends.
*.env
.config/crystal-battle/
# Whole dir: config leaks host aliases and LAN IPs, known_hosts.old the rest.
.ssh/

# Version-pinned install symlinks, not config.
.local/bin/claude
.local/bin/oterm

# ============================================================================
# BACKUP & TEMPORARY FILES
# ============================================================================
*.bak
*.bak[0-9]
*.backup
*.backup-*
*~
*.tmp
*.temp
*.swp
*.swo
.*.sw?

# ============================================================================
# CACHE & STATE
# ============================================================================
.cache/
*.cache
.zcompdump*
.zsh_history
.bash_history
.lesshst
.viminfo
.local/state/
.config/zsh/.zcompdump*
.config/dolphinrc
.config/baloofileinformationrc
.config/pavucontrol.ini
.config/QtProject.conf
session/

# ============================================================================
# HARDWARE/SYSTEM SPECIFIC
# ============================================================================
.config/nvidia/
.config/git/config.local
.config/systemd/*
!.config/systemd/user/
.Xauthority
.ICEauthority

# ============================================================================
# APPLICATION DATA
# ============================================================================
# Remote desktop (may contain server IPs/credentials)
.config/remmina/*.remmina
.config/remmina/remmina_mru.csv

# Browser data
.mozilla/firefox/*/storage/
.mozilla/firefox/*/cache2/
.mozilla/firefox/*/cookies.sqlite
.mozilla/firefox/*/sessionstore*

# ============================================================================
# LOG FILES
# ============================================================================
*.log
.local/share/pomodoro/media-player.log

# ============================================================================
# CLAUDE CODE
# ============================================================================
# Runtime state: caches, session transcripts, shell snapshots, per-project
# memory, telemetry. Not a blanket .claude/ ignore -- settings, hooks and the
# statusline scripts are real config, and statusline-current.sh is already
# tracked. .credentials.json is covered by the *credentials* rule above.
.claude.json
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/statusline*.sh

# ============================================================================
# THEME-SYSTEM OUTPUT (regenerate with `theme set`)
# ============================================================================
# Generated from the tracked palettes/templates under .config/themes/.
# Files already tracked here (the legacy catppuccin-mocha* variants) stay
# tracked; use `git add -f` if a new file in these dirs is real config.
.config/Kvantum/*/
.config/bat/themes/
.config/fsh/
.config/themes/current/
.config/themes/.current
.config/themes/generated/
.config/qt5ct/colors/current.conf
.config/qt6ct/colors/current.conf
.config/spotify-player/theme.toml
.config/hypr/appearance/hyprlock-colors.conf
.config/dunst/icons/

# ============================================================================
# APP STATE, DATA AND BIG DIRS
# ============================================================================
.local/share/
.cmake/
.triton/
.texlive/
.ollama/
.var/
.vite-plus/
.supabase/
.themes/
.config/dconf/
.config/pulse/
.config/go/
.config/blender/
.config/inkscape/
.config/aseprite/
.config/waypaper/
.config/mozilla/
.config/ai.moeru.airi/
.config/org.coolercontrol.CoolerControl/
.config/user-dirs.locale
# Enable-state symlinks are per-machine; the unit files themselves are tracked.
.config/systemd/user/*.target.wants/
# Content dirs, not config.
Developer/
Documents/
Downloads/
Games/
csakura/
team-tools/
gpu-watch/
bookmark-triage-output/
watch_[0-9]*
# These have their own repos.
.dotfiles/
.todo.git/
TODO.md
DONE.md

# ============================================================================
# STALE BACKUPS (the *.bak rule above misses these shapes)
# ============================================================================
*.bak-*
*.obsolete
*.pre-igpu-only

# ============================================================================
# ALLOW ESSENTIAL DOTFILES
# ============================================================================
!.gitignore
!.gitconfig
!.zshenv

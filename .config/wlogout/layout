{
  "label":            "lock",
  "action":           "hyprlock-logged",
  "text":             "Lock",
  "keybind":          "l"
}
{
  "label":            "hibernate",
  "action":           "systemctl hibernate",
  "text":             "Hibernate",
  "keybind":          "h"
}
{
  "label":            "logout",
  "action":           "hyprctl dispatch exit 0",
  "text":             "Logout",
  "keybind":          "e"
}
{
  "label":            "reboot",
  "action":           "systemctl reboot",
  "text":             "Reboot",
  "keybind":          "r"
}
{
  "label":            "suspend",
  "action":           "hyprlock-logged & for _ in $(seq 30); do hyprctl locked | grep -q true && break; sleep 0.1; done; systemctl suspend",
  "text":             "Suspend",
  "keybind":          "u"
}
{
  "label":            "shutdown",
  "action":           "systemctl poweroff",
  "text":             "Shutdown",
  "keybind":          "s"
}

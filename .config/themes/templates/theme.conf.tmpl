# ${THEME_NAME} theme metadata

# Theme identity
name=${THEME_NAME}
description="${THEME_DESCRIPTION}"

# Screen shader (empty = none)
shader=${THEME_SHADER}

# GTK settings
gtk_theme=${THEME_NAME}
gtk_icon_theme=${GTK_ICON_THEME}
gtk_cursor_theme=${CURSOR_THEME}
gtk_cursor_size=${CURSOR_SIZE}

# QT settings (color scheme file in qt5ct/colors/ and qt6ct/colors/)
qt_color_scheme=${QT_COLOR_SCHEME}

# Kvantum theme
kvantum_theme=${THEME_NAME}

#!/usr/bin/env python3
"""
palette-extract: Extract a color palette from an image for terminal + desktop theming.

Wallpaper -> cohesive theme, reasoning in a *perceptual* color space (OKLab/OKLCh)
rather than HSL:

- Colors are extracted with colorthief (dominance-weighted), then all derivation
  happens in OKLCh so lightness/chroma steps are perceptually uniform.
- Surface ramps (crust -> base -> surface -> overlay) step evenly in OKLab L*.
- Semantic/ANSI colors are ANCHORED to canonical hues (red stays red, green stays
  green) and only *borrow* chroma from the wallpaper, so an all-blue wallpaper still
  produces a legible red error color instead of a muddy brick.
- Body text is neutralized (near-zero chroma) so it never picks up a hue cast.
- The gradient builder always returns exactly N colors, so low-hue-variety wallpapers
  (e.g. red-on-black) can't underfill and crash the pipeline.

Outputs a wal-compatible colors.json and, with --generate-theme, the themes-system
chameleon.json palette (then reruns generate-theme.sh chameleon).
"""

import argparse
import colorsys
import json
import math
import os
import sys
import tempfile

try:
    from colorthief import ColorThief
except ImportError:
    print("Error: colorthief not installed. Install with: pip install colorthief")
    sys.exit(1)

try:
    from PIL import Image
except ImportError:
    Image = None  # PIL optional, for large image optimization


# ---------------------------------------------------------------------------
# Basic hex <-> rgb
# ---------------------------------------------------------------------------

def rgb_to_hex(r: int, g: int, b: int) -> str:
    return f"#{int(round(r)):02x}{int(round(g)):02x}{int(round(b)):02x}"


def hex_to_rgb(hex_color: str) -> tuple[int, int, int]:
    hex_color = hex_color.lstrip("#")
    return tuple(int(hex_color[i:i + 2], 16) for i in (0, 2, 4))


def clamp(x: float, lo: float, hi: float) -> float:
    return lo if x < lo else hi if x > hi else x


# ---------------------------------------------------------------------------
# sRGB <-> OKLab <-> OKLCh  (Björn Ottosson's OKLab)
#
# We reason about color in OKLCh because equal steps in L*/C* look equal to the
# eye, unlike HSL. Hue is in degrees (0-360), L in 0..1, C is unbounded but
# ~0.0-0.37 for in-gamut sRGB.
# ---------------------------------------------------------------------------

def _srgb_to_linear(c: float) -> float:
    """c in 0..1 sRGB -> linear."""
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _linear_to_srgb(c: float) -> float:
    """c in 0..1 linear -> sRGB."""
    return 12.92 * c if c <= 0.0031308 else 1.055 * (c ** (1 / 2.4)) - 0.055


def rgb_to_oklab(rgb: tuple) -> tuple[float, float, float]:
    r, g, b = (_srgb_to_linear(v / 255) for v in rgb)

    l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b

    l_ = math.copysign(abs(l) ** (1 / 3), l)
    m_ = math.copysign(abs(m) ** (1 / 3), m)
    s_ = math.copysign(abs(s) ** (1 / 3), s)

    L = 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_
    a = 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_
    bb = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
    return L, a, bb


def _oklab_to_linear_rgb(L: float, a: float, b: float) -> tuple[float, float, float]:
    l_ = L + 0.3963377774 * a + 0.2158037573 * b
    m_ = L - 0.1055613458 * a - 0.0638541728 * b
    s_ = L - 0.0894841775 * a - 1.2914855480 * b

    l = l_ ** 3
    m = m_ ** 3
    s = s_ ** 3

    r = +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
    g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
    bb = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    return r, g, bb


def _in_gamut(linear_rgb: tuple, eps: float = 1e-4) -> bool:
    return all(-eps <= c <= 1 + eps for c in linear_rgb)


def oklab_to_rgb(L: float, a: float, b: float) -> tuple[int, int, int]:
    """OKLab -> sRGB 0..255, clamping out-of-gamut channels."""
    lin = _oklab_to_linear_rgb(L, a, b)
    out = tuple(int(round(clamp(_linear_to_srgb(clamp(c, 0.0, 1.0)), 0.0, 1.0) * 255)) for c in lin)
    return out


def rgb_to_oklch(rgb: tuple) -> tuple[float, float, float]:
    L, a, b = rgb_to_oklab(rgb)
    C = math.hypot(a, b)
    h = math.degrees(math.atan2(b, a)) % 360
    return L, C, h


def oklch_to_rgb(L: float, C: float, h: float) -> tuple[int, int, int]:
    """OKLCh -> sRGB 0..255. If (L,C,h) is out of the sRGB gamut, reduce chroma
    (keeping L and hue) until it fits, so hue and perceived lightness are preserved
    instead of getting mangled by naive channel clamping."""
    L = clamp(L, 0.0, 1.0)
    hr = math.radians(h)
    ca, cb = math.cos(hr), math.sin(hr)

    def lab_at(chroma):
        return _oklab_to_linear_rgb(L, chroma * ca, chroma * cb)

    if not _in_gamut(lab_at(C)):
        lo, hi = 0.0, C
        for _ in range(24):
            mid = (lo + hi) / 2
            if _in_gamut(lab_at(mid)):
                lo = mid
            else:
                hi = mid
        C = lo

    return oklab_to_rgb(L, C * ca, C * cb)


# ---------------------------------------------------------------------------
# WCAG contrast (unchanged standard: relative luminance in linear sRGB)
# ---------------------------------------------------------------------------

def get_luminance(r: int, g: int, b: int) -> float:
    def ch(c):
        c = c / 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    return 0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(b)


def contrast_ratio(c1: tuple, c2: tuple) -> float:
    l1, l2 = get_luminance(*c1), get_luminance(*c2)
    lighter, darker = max(l1, l2), min(l1, l2)
    return (lighter + 0.05) / (darker + 0.05)


def oklch_with_contrast(L: float, C: float, h: float, bg_rgb: tuple,
                        target: float = 4.5) -> tuple[int, int, int]:
    """Render an OKLCh color, nudging L* until it meets `target` WCAG contrast
    against bg. Direction is chosen by bg luminance (lighten on dark bg, darken on
    light bg). Chroma is preserved where the gamut allows."""
    lighten = get_luminance(*bg_rgb) < 0.5
    step = 0.015
    cur_L = L
    best = oklch_to_rgb(cur_L, C, h)
    for _ in range(70):
        rgb = oklch_to_rgb(cur_L, C, h)
        if contrast_ratio(rgb, bg_rgb) >= target:
            return rgb
        cur_L += step if lighten else -step
        if cur_L >= 1.0 or cur_L <= 0.0:
            cur_L = clamp(cur_L, 0.0, 1.0)
            best = oklch_to_rgb(cur_L, C, h)
            break
        best = rgb
    return best


def hue_dist(a: float, b: float) -> float:
    """Circular distance between two hues in degrees (0..180)."""
    d = abs(a - b) % 360
    return min(d, 360 - d)


# ---------------------------------------------------------------------------
# Color extraction (colorthief front-end, dominance-weighted)
# ---------------------------------------------------------------------------

def rgb_to_hsl(r: int, g: int, b: int) -> tuple[float, float, float]:
    """HSL, kept only for the human-readable --verbose dump."""
    h, l, s = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
    return h * 360, s, l


def extract_colors_with_dominance(image_path: str, color_count: int = 30,
                                  verbose: bool = False) -> list[tuple]:
    """Extract dominant colors with dominance weights (0..1, earlier = more dominant)."""
    process_path = image_path
    temp_file = None

    if Image is not None:
        try:
            img = Image.open(image_path).convert("RGB")
            max_dim = 1600
            if max(img.size) > max_dim:
                if verbose:
                    print(f"  Resizing {img.size[0]}x{img.size[1]} -> ", end="")
                ratio = max_dim / max(img.size)
                new_size = (int(img.width * ratio), int(img.height * ratio))
                img = img.resize(new_size, Image.LANCZOS)
                if verbose:
                    print(f"{new_size[0]}x{new_size[1]} for faster processing")
                temp_file = tempfile.NamedTemporaryFile(suffix=".png", delete=False)
                img.save(temp_file.name)
                process_path = temp_file.name
            img.close()
        except Exception as e:
            if verbose:
                print(f"  Warning: could not resize image: {e}")

    try:
        ct = ColorThief(process_path)
        try:
            palette = ct.get_palette(color_count=color_count, quality=5)
        except Exception:
            palette = ct.get_palette(color_count=color_count, quality=20)
    finally:
        if temp_file is not None:
            try:
                os.unlink(temp_file.name)
            except Exception:
                pass

    weighted = []
    for i, color in enumerate(palette):
        dominance = 1.0 / (1 + i * 0.3)
        weighted.append((tuple(color), dominance))
    return weighted


def detect_image_type(colors_weighted: list) -> str:
    """"monochrome" if the image has little chroma variety, else "normal"."""
    if not colors_weighted:
        return "monochrome"
    chromas = [rgb_to_oklch(c)[1] for c, _ in colors_weighted]
    avg_c = sum(chromas) / len(chromas)
    chromatic = sum(1 for c in chromas if c > 0.04)
    if avg_c < 0.03 or chromatic < 3:
        return "monochrome"
    return "normal"


# ---------------------------------------------------------------------------
# Background / foreground
# ---------------------------------------------------------------------------

def select_background(colors_weighted: list, light_mode: bool = False) -> tuple[int, int, int]:
    """Pick a background: darkest (dark mode) / lightest (light mode) dominant color,
    with chroma pulled way down and lightness pinned to a comfortable range."""
    data = [(c, rgb_to_oklch(c), d) for c, d in colors_weighted]

    if light_mode:
        def score(lch, dom):
            L, C, _ = lch
            return L * 0.55 + (0.3 - min(C, 0.3)) * 0.5 + dom * 0.15
        target_L, chroma_cap = 0.95, 0.02
    else:
        def score(lch, dom):
            L, C, _ = lch
            return (1 - L) * 0.55 + (0.3 - min(C, 0.3)) * 0.5 + dom * 0.15
        target_L, chroma_cap = 0.14, 0.022

    best = max(data, key=lambda x: score(x[1], x[2]))
    L, C, h = best[1]
    # Keep a whisper of the image's hue but force it dark/light and near-neutral.
    L = clamp(L, 0.05, 0.20) if not light_mode else clamp(L, 0.90, 0.98)
    L = target_L * 0.6 + L * 0.4
    return oklch_to_rgb(L, min(C, chroma_cap), h)


def select_foreground(bg_rgb: tuple, light_mode: bool = False,
                      bg_hue: float | None = None) -> tuple[int, int, int]:
    """Neutralized body text: near-zero chroma (a hint of the bg hue) with a strong
    contrast guarantee, so text never comes out visibly tinted."""
    _, _, h = rgb_to_oklch(bg_rgb)
    if bg_hue is not None:
        h = bg_hue
    L = 0.93 if not light_mode else 0.22
    return oklch_with_contrast(L, 0.012, h, bg_rgb, target=8.0)


# ---------------------------------------------------------------------------
# Anchored ANSI / semantic colors
#
# Canonical OKLCh hues for each terminal color. We keep these hues fixed and only
# borrow chroma from whatever the wallpaper offers near that hue, so semantics stay
# recognizable regardless of the image.
# ---------------------------------------------------------------------------

CANON_HUES = {
    "red": 29.0,
    "yellow": 100.0,
    "green": 142.0,
    "cyan": 195.0,
    "blue": 264.0,
    "magenta": 328.0,
}
DEFAULT_CHROMA = {
    "red": 0.15, "yellow": 0.14, "green": 0.15,
    "cyan": 0.11, "blue": 0.13, "magenta": 0.14,
}


def borrow_chroma(oklch_colors: list, target_hue: float, default: float,
                  window: float = 35.0) -> float:
    """Chroma to use for a canonical hue: the vivid end of what the wallpaper has
    near that hue (falling back to a sensible default if it has nothing there)."""
    near = [C for (L, C, h) in oklch_colors
            if C > 0.03 and hue_dist(h, target_hue) <= window]
    if not near:
        return default
    near.sort()
    # 75th-percentile-ish: lean toward the vivid colors present, but don't take a
    # single freak max. Floor at 0.8*default so a hue the wallpaper barely contains
    # still yields a legibly-colored semantic instead of a washed-out one.
    picked = near[int(len(near) * 0.75)]
    return clamp(max(picked, default * 0.8), 0.05, 0.20)


def map_ansi_colors(colors_weighted: list, bg_rgb: tuple, light_mode: bool = False,
                    verbose: bool = False) -> dict:
    """Anchored ANSI colors 1-6 (normal) and 9-14 (bright). Hues are canonical;
    chroma is borrowed from the image; lightness targets a legible band and is
    contrast-clamped against bg."""
    oklch_colors = [rgb_to_oklch(c) for c, _ in colors_weighted]

    norm_L = 0.66 if not light_mode else 0.52
    bright_L = 0.80 if not light_mode else 0.42

    normals, brights = {}, {}
    for name, hue in CANON_HUES.items():
        C = borrow_chroma(oklch_colors, hue, DEFAULT_CHROMA[name])
        normals[name] = oklch_with_contrast(norm_L, C, hue, bg_rgb, target=3.5)
        brights[name] = oklch_with_contrast(bright_L, C * 0.92, hue, bg_rgb, target=3.0)
        if verbose:
            print(f"  ansi {name:<8} hue={hue:5.1f} C={C:.3f} "
                  f"-> {rgb_to_hex(*normals[name])} / {rgb_to_hex(*brights[name])}")

    return {
        "color1": normals["red"],    "color9": brights["red"],
        "color2": normals["green"],  "color10": brights["green"],
        "color3": normals["yellow"], "color11": brights["yellow"],
        "color4": normals["blue"],   "color12": brights["blue"],
        "color5": normals["magenta"], "color13": brights["magenta"],
        "color6": normals["cyan"],   "color14": brights["cyan"],
    }


def generate_grayscale(bg_rgb: tuple, fg_rgb: tuple, light_mode: bool = False) -> dict:
    """Neutral ANSI 0/7/8/15 (black, white, bright-black, bright-white), stepped in
    OKLab L* with a faint bg hue for cohesion."""
    _, bg_C, bg_h = rgb_to_oklch(bg_rgb)
    tint = min(bg_C, 0.012)

    if light_mode:
        levels = {"color0": 0.80, "color8": 0.60, "color7": 0.32, "color15": 0.15}
    else:
        levels = {"color0": 0.28, "color8": 0.48, "color7": 0.80, "color15": 0.93}

    return {name: oklch_to_rgb(L, tint, bg_h) for name, L in levels.items()}


# ---------------------------------------------------------------------------
# Gradient (rainbow strip) - always returns exactly `count` colors
# ---------------------------------------------------------------------------

def select_gradient_colors(colors_weighted: list, count: int = 10,
                           verbose: bool = False) -> list:
    """Pick `count` vibrant colors for the gradient, sorted by hue. Guaranteed to
    return exactly `count`: if the wallpaper is too low-variety to supply enough
    distinct colors, we synthesize perceptual variations (stepping L* along the hues
    we have) so the pipeline can never underfill and crash."""
    data = [(c, rgb_to_oklch(c), d) for c, d in colors_weighted]

    # Candidates: real chroma, not near-black/white.
    cand = [(c, lch, d) for c, lch, d in data
            if lch[1] > 0.03 and 0.12 < lch[0] < 0.92]
    if len(cand) < 2:
        cand = [(c, lch, d) for c, lch, d in data if lch[1] > 0.015] or data

    # Rank by vividness with dominance as a gentle noise filter.
    cand.sort(key=lambda x: -(x[1][1] * (0.4 + 0.6 * x[2])))

    picked = []  # list of (rgb, (L,C,h))
    for c, lch, _ in cand:
        L, C, h = lch
        too_close = any(hue_dist(h, ph) < 12 and abs(L - pL) < 0.10
                        for _, (pL, _, ph) in picked)
        if not too_close:
            picked.append((c, lch))
        if len(picked) >= count:
            break

    # Fill any shortfall with L* variations of what we have (never duplicates).
    if picked:
        i = 0
        step = 1
        while len(picked) < count:
            base_c, (L, C, h) = picked[i % len(picked)]
            shift = 0.09 * step * (1 if (i % 2 == 0) else -1)
            newL = clamp(L + shift, 0.22, 0.85)
            picked.append((oklch_to_rgb(newL, C, h), (newL, C, h)))
            i += 1
            if i % max(1, len(picked)) == 0:
                step += 1
    else:
        # Total fallback: neutral ramp (monochrome/grayscale image).
        for k in range(count):
            L = 0.25 + 0.6 * (k / max(1, count - 1))
            picked.append((oklch_to_rgb(L, 0.0, 0.0), (L, 0.0, 0.0)))

    # Normalize lightness a touch for a consistent strip, then sort by hue.
    result = [c for c, _ in picked[:count]]
    result.sort(key=lambda c: rgb_to_oklch(c)[2])
    if verbose:
        print(f"  gradient: {len(result)} colors "
              f"(hue spread {_hue_spread(result):.0f})")
    return result


def _hue_spread(colors: list) -> float:
    hues = sorted(rgb_to_oklch(c)[2] for c in colors)
    if len(hues) < 2:
        return 0.0
    max_gap = 0.0
    for i in range(len(hues)):
        nxt = hues[(i + 1) % len(hues)]
        gap = (nxt - hues[i]) % 360 if i < len(hues) - 1 else (360 - hues[i]) + hues[0]
        max_gap = max(max_gap, gap)
    return 360 - max_gap


# ---------------------------------------------------------------------------
# Assemble the wal-format palette
# ---------------------------------------------------------------------------

def generate_palette(image_path: str, light_mode: bool = False,
                     verbose: bool = False) -> dict:
    if verbose:
        print(f"Extracting colors from: {image_path}")

    colors_weighted = extract_colors_with_dominance(image_path, color_count=30, verbose=verbose)
    if not colors_weighted:
        print("Error: could not extract colors from image")
        sys.exit(1)

    if verbose:
        print(f"  Extracted {len(colors_weighted)} colors")
        for c, d in colors_weighted[:12]:
            L, C, h = rgb_to_oklch(c)
            print(f"    {rgb_to_hex(*c)}  L:{L:.2f} C:{C:.3f} h:{h:5.1f}  dom:{d:.2f}")

    image_type = detect_image_type(colors_weighted)
    if verbose:
        print(f"  Image type: {image_type}")
    if image_type == "monochrome":
        print("Note: low-chroma image; accent colors will lean on canonical defaults")

    bg_rgb = select_background(colors_weighted, light_mode)
    _, _, bg_h = rgb_to_oklch(bg_rgb)
    fg_rgb = select_foreground(bg_rgb, light_mode, bg_hue=bg_h)
    cursor_rgb = fg_rgb

    if verbose:
        bL, bC, bh = rgb_to_oklch(bg_rgb)
        fL, fC, fh = rgb_to_oklch(fg_rgb)
        print(f"  Background: {rgb_to_hex(*bg_rgb)} (L:{bL:.2f} C:{bC:.3f} h:{bh:.0f})")
        print(f"  Foreground: {rgb_to_hex(*fg_rgb)} (L:{fL:.2f} C:{fC:.3f} h:{fh:.0f})")

    gradient = select_gradient_colors(colors_weighted, count=10, verbose=verbose)
    ansi_colors = map_ansi_colors(colors_weighted, bg_rgb, light_mode, verbose=verbose)
    grayscale = generate_grayscale(bg_rgb, fg_rgb, light_mode)

    palette = {
        "wallpaper": os.path.abspath(image_path),
        "alpha": "100",
        "special": {
            "background": rgb_to_hex(*bg_rgb),
            "foreground": rgb_to_hex(*fg_rgb),
            "cursor": rgb_to_hex(*cursor_rgb),
        },
        "colors": {
            "color0": rgb_to_hex(*grayscale["color0"]),
            "color1": rgb_to_hex(*ansi_colors["color1"]),
            "color2": rgb_to_hex(*ansi_colors["color2"]),
            "color3": rgb_to_hex(*ansi_colors["color3"]),
            "color4": rgb_to_hex(*ansi_colors["color4"]),
            "color5": rgb_to_hex(*ansi_colors["color5"]),
            "color6": rgb_to_hex(*ansi_colors["color6"]),
            "color7": rgb_to_hex(*grayscale["color7"]),
            "color8": rgb_to_hex(*grayscale["color8"]),
            "color9": rgb_to_hex(*ansi_colors["color9"]),
            "color10": rgb_to_hex(*ansi_colors["color10"]),
            "color11": rgb_to_hex(*ansi_colors["color11"]),
            "color12": rgb_to_hex(*ansi_colors["color12"]),
            "color13": rgb_to_hex(*ansi_colors["color13"]),
            "color14": rgb_to_hex(*ansi_colors["color14"]),
            "color15": rgb_to_hex(*grayscale["color15"]),
        },
        "gradient": {f"g{i}": rgb_to_hex(*gradient[i]) for i in range(count_of(gradient, 10))},
    }
    return palette


def count_of(seq, n) -> int:
    """Defensive: gradient is guaranteed length n, but never index past it."""
    return min(len(seq), n)


# ---------------------------------------------------------------------------
# themes-system chameleon.json (OKLCh surface ramp + chroma-ranked accents)
# ---------------------------------------------------------------------------

def _neutral_hex(L: float, bg_rgb: tuple, chroma: float = 0.01) -> str:
    _, bg_C, bg_h = rgb_to_oklch(bg_rgb)
    return rgb_to_hex(*oklch_to_rgb(L, min(bg_C, chroma), bg_h))


def _surface_ramp(bg_rgb: tuple, light_mode: bool) -> dict:
    """Perceptually-even structural shades derived from the background in OKLab L*."""
    bg_L, bg_C, bg_h = rgb_to_oklch(bg_rgb)
    surf_C = min(bg_C, 0.03)

    if not light_mode:
        base_L = clamp(bg_L, 0.10, 0.20)
        offs = {"crust": -0.03, "mantle": 0.0, "base": 0.0, "surface0": 0.045,
                "surface1": 0.085, "surface2": 0.125, "overlay0": 0.175,
                "overlay1": 0.245, "overlay2": 0.34}
    else:
        base_L = clamp(bg_L, 0.88, 0.97)
        offs = {"crust": 0.03, "mantle": 0.0, "base": 0.0, "surface0": -0.04,
                "surface1": -0.075, "surface2": -0.11, "overlay0": -0.16,
                "overlay1": -0.22, "overlay2": -0.30}

    return {name: rgb_to_hex(*oklch_to_rgb(clamp(base_L + off, 0.03, 0.72), surf_C, bg_h))
            for name, off in offs.items()}


def _rank_accents(colors: dict) -> list:
    """Rank ANSI normals 1-6 by chroma (vividness) with hue diversity, so the primary
    accent reflects the wallpaper's signature color instead of always being blue.
    Returns a list of ('colorN','colorM') = (normal, bright) keys, most vivid first."""
    slots = [("color1", "color9"), ("color2", "color10"), ("color3", "color11"),
             ("color4", "color12"), ("color5", "color13"), ("color6", "color14")]
    scored = []
    for norm, bright in slots:
        L, C, h = rgb_to_oklch(hex_to_rgb(colors[norm]))
        scored.append((C, h, norm, bright))
    scored.sort(key=lambda x: -x[0])

    picked = []
    for C, h, norm, bright in scored:
        if any(hue_dist(h, ph) < 30 for _, ph, _, _ in picked):
            continue
        picked.append((C, h, norm, bright))
    for item in scored:  # top up if diversity filter left <3
        if item not in picked:
            picked.append(item)
        if len(picked) >= 3:
            break
    return [(norm, bright) for _, _, norm, bright in picked[:3]]


def generate_theme_palette(palette: dict, output_path: str) -> None:
    """Map the wal-format palette into the themes-system chameleon.json schema.

    Works purely from the wal palette (special + color0-15 + gradient), so the
    --from-cache / undo path keeps working. Surfaces are an OKLab ramp from bg;
    semantics come straight from the (already anchored) ANSI colors; accents are
    chroma-ranked so the theme's headline color tracks the wallpaper."""
    colors = palette["colors"]
    gradient = palette["gradient"]
    bg = palette["special"]["background"]
    fg = palette["special"]["foreground"]
    bg_rgb = hex_to_rgb(bg)
    light_mode = get_luminance(*bg_rgb) > 0.5

    ramp = _surface_ramp(bg_rgb, light_mode)
    (a0n, a0b), (a1n, a1b), (a2n, a2b) = _rank_accents(colors)

    # subtext levels between text and surfaces (neutral).
    if not light_mode:
        subtext1 = _neutral_hex(0.74, bg_rgb)
        subtext0 = _neutral_hex(0.62, bg_rgb)
    else:
        subtext1 = _neutral_hex(0.38, bg_rgb)
        subtext0 = _neutral_hex(0.48, bg_rgb)

    theme_palette = {
        "description": "Dynamic theme from wallpaper",
        "colors": {
            # Structural (OKLab-even ramp)
            "crust": ramp["crust"],
            "mantle": ramp["mantle"],
            "base": ramp["base"],
            "surface0": ramp["surface0"],
            "surface1": ramp["surface1"],
            "surface2": ramp["surface2"],
            "overlay0": ramp["overlay0"],
            "overlay1": ramp["overlay1"],
            "overlay2": ramp["overlay2"],
            "text": fg,
            "subtext1": subtext1,
            "subtext0": subtext0,
            "module_fg": bg,
            "module_fg_light": fg,
            # Accents (chroma-ranked from the wallpaper)
            "accent": colors[a0n],
            "accent_secondary": colors[a1n],
            "accent_tertiary": colors[a2n],
            "accent_bright": colors[a0b],
            "accent_secondary_bright": colors[a1b],
            "accent_tertiary_bright": colors[a2b],
            # Semantics (anchored hues via ANSI slots)
            "sem_ok": colors["color2"],      # green
            "sem_warn": colors["color3"],    # yellow
            "sem_err": colors["color1"],     # red
            "sem_info": colors["color6"],    # cyan
            "sem_link": colors["color4"],    # blue
            "sem_match": colors["color3"],   # yellow
            "sem_cursor": fg,
            "sem_border": colors[a0n],       # headline accent
            "sem_selection": ramp["surface2"],
            # File-type colors
            "ft_code": colors["color2"],
            "ft_data": colors["color3"],
            "ft_media": colors["color5"],
            "ft_archive": colors["color6"],
            "ft_executable": colors["color1"],
            "ft_build": colors["color4"],
            "ft_ignore": colors["color8"],
            # ANSI (normal + bright)
            "ansi_red": colors["color1"],
            "ansi_green": colors["color2"],
            "ansi_yellow": colors["color3"],
            "ansi_blue": colors["color4"],
            "ansi_magenta": colors["color5"],
            "ansi_cyan": colors["color6"],
            "ansi_red_bright": colors["color9"],
            "ansi_green_bright": colors["color10"],
            "ansi_yellow_bright": colors["color11"],
            "ansi_blue_bright": colors["color12"],
            "ansi_magenta_bright": colors["color13"],
            "ansi_cyan_bright": colors["color14"],
        },
        "gradient": [gradient[f"g{i}"] for i in range(count_of(gradient, 10))],
    }

    out_dir = os.path.dirname(output_path)
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)
    with open(output_path, "w") as f:
        json.dump(theme_palette, f, indent=2)


# ---------------------------------------------------------------------------
# Preview
# ---------------------------------------------------------------------------

def print_color_preview(palette: dict) -> None:
    def block(hexc, width=2):
        r, g, b = hex_to_rgb(hexc)
        return f"\033[48;2;{r};{g};{b}m{' ' * width}\033[0m"

    print("\nBackground/Foreground:")
    sp = palette["special"]
    print(f"  {block(sp['background'])} bg {sp['background']}  "
          f"{block(sp['foreground'])} fg {sp['foreground']}  "
          f"{block(sp['cursor'])} cursor {sp['cursor']}")

    print("\nANSI Colors (0-7):")
    print("  " + "".join(f"{block(palette['colors'][f'color{i}'])} {i:<2} " for i in range(8)))
    print("ANSI Colors (8-15):")
    print("  " + "".join(f"{block(palette['colors'][f'color{i}'])} {i:<2} " for i in range(8, 16)))

    print("\nColor names:")
    names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    for i, name in enumerate(names):
        c = palette["colors"][f"color{i}"]
        cb = palette["colors"][f"color{i + 8}"]
        print(f"  {block(c)} {name:<8} {c}  {block(cb)} bright {cb}")

    print("\nGradient:")
    n = count_of(palette["gradient"], 10)
    print("  " + "".join(block(palette["gradient"][f"g{i}"], 3) for i in range(n)))
    print("  " + " ".join(palette["gradient"][f"g{i}"] for i in range(n)))
    print()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Extract a perceptual color palette from an image for theming"
    )
    parser.add_argument("image", nargs="?", help="Path to image file (optional with --from-cache)")
    parser.add_argument("-l", "--light", action="store_true", help="Generate light color scheme")
    parser.add_argument("-o", "--output", help="Output file (default: ~/.cache/wal/colors.json)")
    parser.add_argument("-p", "--print", action="store_true", help="Print palette JSON to stdout")
    parser.add_argument("-v", "--verbose", action="store_true", help="Show color selection details")
    parser.add_argument("--preview", action="store_true", help="Print color swatches to terminal")
    parser.add_argument("-t", "--generate-theme", action="store_true",
                        help="Generate chameleon.json and run generate-theme.sh")
    parser.add_argument("--from-cache", action="store_true",
                        help="Skip extraction, use existing ~/.cache/wal/colors.json")

    args = parser.parse_args()

    if args.from_cache:
        cache_path = os.path.expanduser("~/.cache/wal/colors.json")
        if not os.path.isfile(cache_path):
            print(f"Error: no cached colors found at {cache_path}")
            sys.exit(1)
        with open(cache_path) as f:
            palette = json.load(f)
        if args.verbose:
            print(f"Loaded cached palette from {cache_path}")
    else:
        if not args.image:
            print("Error: image path required (or use --from-cache)")
            sys.exit(1)
        if not os.path.isfile(args.image):
            print(f"Error: image not found: {args.image}")
            sys.exit(1)
        try:
            palette = generate_palette(args.image, light_mode=args.light, verbose=args.verbose)
        except Exception as e:
            print(f"Error extracting colors: {e}")
            sys.exit(1)

    if args.preview:
        print_color_preview(palette)

    output_json = json.dumps(palette, indent=4)

    if args.print:
        print(output_json)
    else:
        output_path = args.output or os.path.expanduser("~/.cache/wal/colors.json")
        output_dir = os.path.dirname(output_path)
        os.makedirs(output_dir, exist_ok=True)
        if args.image:
            with open(os.path.join(output_dir, "wal"), "w") as f:
                f.write(os.path.abspath(args.image))
        with open(output_path, "w") as f:
            f.write(output_json)
        print(f"Palette written to {output_path}")

    if args.generate_theme:
        themes_dir = os.path.expanduser("~/.config/themes")
        chameleon_json = os.path.join(themes_dir, "palettes", "chameleon.json")
        print(f"Generating theme palette: {chameleon_json}")
        generate_theme_palette(palette, chameleon_json)

        scripts_dir = os.path.join(themes_dir, "scripts")
        generate_script = os.path.join(scripts_dir, "generate-theme.sh")
        if os.path.isfile(generate_script):
            import subprocess
            print("Running generate-theme.sh chameleon...")
            result = subprocess.run([generate_script, "chameleon"], cwd=scripts_dir)
            if result.returncode != 0:
                print("Error: generate-theme.sh failed")
                sys.exit(1)
            # starship.toml is assembled by generate-theme.sh (build-starship.sh);
            # the old update-starship-palettes.sh was removed in the 2026-06-17 refactor.
        else:
            print(f"Warning: {generate_script} not found, skipping theme generation")


if __name__ == "__main__":
    main()

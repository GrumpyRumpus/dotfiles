[Unit]
Description=crystal-battle PokeAgent free-play ladder (gen9ou, as PAC-Crystal)
# Timer- or manually-triggered; not enabled on login on purpose.

[Service]
Type=simple
WorkingDirectory=/home/wiz/Developer/grimoire/crystal-battle
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# overnight_ladder.sh handles everything: sleep-inhibit, cred sourcing from
# ~/.config/crystal-battle/pokeagent.env, one-game-per-process with per-game
# timeout + team rotation, an 8h wall-clock cap, and the end-of-run loss-trace.
# A same-name login kicks any running stream, so its own preflight refuses to
# start a second one.
ExecStart=/bin/sh showdown/overnight_ladder.sh 120 showdown/teams/pool_hl
# stop = SIGTERM the whole cgroup (kills the in-flight game cleanly); per-game
# logs are already flushed, so we never lose more than the game in progress.
KillMode=control-group
TimeoutStopSec=30

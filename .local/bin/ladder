#!/bin/sh
# Simple control for the crystal-battle PokeAgent ladder (systemd user service).
# Usage: ladder {start|stop|status|log|tally|trace|nightly|off}
#
#   tally [all|teams|arch|since <date>|<log>]  breakdown of session log(s) (see ladder_tally.awk)
#   trace [<log>]             deep loss-trace pass (loss_trace.py)
SVC=crystal-ladder.service
TMR=crystal-ladder.timer
CB=/home/wiz/Developer/grimoire/crystal-battle
CRED="$HOME/.config/crystal-battle/pokeagent.env"

# our showdown name, as the logs record it (same source overnight_ladder.sh uses)
ps_name() {
  if [ -f "$CRED" ]; then (. "$CRED"; echo "${PS_USERNAME:-PAC-Crystal}")
  else echo PAC-Crystal; fi
}
latest_log() { ls -t "$CB"/showdown/bench/overnight_*_ladder.log 2>/dev/null | head -1; }
all_logs()   { ls -tr "$CB"/showdown/bench/overnight_*_ladder.log 2>/dev/null; }

cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
  start)
    systemctl --user start "$SVC" && echo "ladder: started (queuing gen9oulongtimer as $(ps_name))"
    ;;
  stop)
    systemctl --user stop "$SVC" && echo "ladder: stopped"
    ;;
  status)
    systemctl --user status "$SVC" --no-pager
    ;;
  log)
    # follow the current session's own log (richer than journald for game flow)
    L=$(latest_log)
    [ -n "$L" ] && tail -f "$L" || echo "no ladder log yet"
    ;;
  tally)
    # breakdown: per-opponent / per-team standings, board-vs-clock endings,
    # walkovers pulled out of the headline number, form string.
    #   since <date>  keep only sessions on/after YYYYMMDD (e.g. since 20260727
    #                 to drop the tera-OFF era); implies 'all' when no log named.
    TEAMS=0
    ARCH=0
    LOGS=""
    SINCE=""
    while [ $# -gt 0 ]; do
      case "$1" in
        teams|--teams)     TEAMS=1 ;;
        arch|--arch)       ARCH=1 ;;
        all|--all)         LOGS="$(all_logs)" ;;
        since|--since)     SINCE="$2"; shift ;;
        since=*|--since=*) SINCE="${1#*=}" ;;
        *)
          if [ -f "$1" ]; then LOGS="$LOGS $1"
          elif [ -f "$CB/showdown/bench/$1" ]; then LOGS="$LOGS $CB/showdown/bench/$1"
          else echo "ladder tally: no such log: $1" >&2; exit 1; fi ;;
      esac
      shift
    done
    # a bare `since <date>` means "every session on/after that date"
    [ -n "$SINCE" ] && [ -z "$LOGS" ] && LOGS="$(all_logs)"
    if [ -n "$SINCE" ]; then
      sd=$(printf '%s' "$SINCE" | tr -cd 0-9 | cut -c1-8)   # normalize -> YYYYMMDD
      keep=""
      for f in $LOGS; do
        stamp=$(basename "$f" | sed -nE 's/^overnight_([0-9]{8})_.*/\1/p')
        [ -n "$stamp" ] && [ "$stamp" -ge "$sd" ] 2>/dev/null && keep="$keep $f"
      done
      LOGS="$keep"
      [ -z "$LOGS" ] && { echo "ladder tally: no sessions on/after $sd"; exit 0; }
    fi
    [ -z "$LOGS" ] && LOGS=$(latest_log)
    [ -z "$LOGS" ] && { echo "no ladder log yet"; exit 0; }
    AWKF="$CB/showdown/ladder_tally.awk"
    [ -f "$AWKF" ] || { echo "ladder tally: missing $AWKF" >&2; exit 1; }
    # `arch` pools per-team results into archetypes; classify_pool.py rebuilds
    # the team->archetype map from pool_hl each run so it can't go stale.
    AMAP=""; ARCHARG=""
    if [ "$ARCH" = 1 ]; then
      AMAP=$(mktemp)
      "$CB"/.venv/bin/python "$CB"/showdown/classify_pool.py \
          "$CB/showdown/teams/pool_hl" > "$AMAP" 2>/dev/null
      ARCHARG="-v archmap=$AMAP"
    fi
    # shellcheck disable=SC2086  # LOGS/ARCHARG are intentional word-split lists
    awk -v me="$(ps_name)" -v show_teams="$TEAMS" $ARCHARG -f "$AWKF" $LOGS
    [ -n "$AMAP" ] && rm -f "$AMAP"
    ;;
  trace)
    # the deep read: collapses, first-deaths, killers, tera timing
    L="${1:-$(latest_log)}"
    [ -z "$L" ] && { echo "no ladder log yet"; exit 0; }
    [ -f "$L" ] || L="$CB/showdown/bench/$L"
    [ -f "$L" ] || { echo "ladder trace: no such log" >&2; exit 1; }
    "$CB"/.venv/bin/python "$CB"/showdown/loss_trace.py --name "$(ps_name)" \
        --collapse-examples 3 "$L"
    ;;
  nightly)
    systemctl --user enable --now "$TMR" && echo "ladder: nightly timer ON (01:00)"
    systemctl --user list-timers "$TMR" --no-pager 2>/dev/null | head -3
    ;;
  off)
    systemctl --user disable --now "$TMR" && echo "ladder: nightly timer OFF"
    ;;
  *)
    echo "usage: ladder {start|stop|status|log|tally|trace|nightly|off}"
    echo "       ladder tally [all] [teams] [arch] [since <YYYYMMDD>] [<log>]"
    ;;
esac

#!/bin/bash
# Bring up the wallpaper. The daemon itself lives in awww-daemon.service so it
# survives the terminal that launched it and is restarted when a wl_output
# teardown kills it; this script is just the entry point that starts it.
#
# The daemon is deliberately NOT spawned here any more. Having a bare
# awww-daemon and a supervised one both bound to the background layer is worse
# than having neither.

set -u

systemctl --user start awww-daemon.service || exit 1

# The unit's ExecStartPost already restores, but run it again so calling this
# script against an already-running daemon re-applies the wallpaper.
exec "$HOME/.local/bin/wallpaper-restore"
